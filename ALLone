      "content": "const dialog=document.getElementById('appDialog'),toast=document.getElementById('toast');let timer,role='speaker',filter='all';\nfunction open(kind,name){const data=typeof content[kind]==='function'?content[kind](name):content[kind];document.getElementById('dialogIcon').textContent=data.icon;document.getElementById('dialogEyebrow').textContent=data.eyebrow;document.getElementById('dialogTitle').textContent=data.title;document.getElementById('dialogBody').innerHTML=data.body;const actions=document.getElementById('dialogActions');actions.replaceChildren();data.actions.forEach(([label,cls,fn])=>{const b=document.createElement('button');b.textContent=label;if(cls)b.className=cls;b.onclick=fn||close;actions.append(b)});dialog.showModal()}const close=()=>dialog.close();\nfunction toastShow(message){toast.textContent=message;toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),2800)}\nconst content={connect:n=>({icon:'♡',eyebrow:'A FIRST HELLO',title:`Say hello to ${n}.`,body:`<p>A conversation starts when you're ready. Share as much or as little as you like, and leave at any time.</p><p><strong>Before you connect:</strong> be kind, respect boundaries, and never share private contact or financial details.</p>`,actions:[['Maybe later',''],['Start a conversation','primary-action',()=>toastShow('This is a demo — conversations aren’t connected yet.')]]}),checkin:{icon:'☁',eyebrow:'DAILY CHECK-IN',title:'How are you arriving today?',body:`<p>No need to overthink it.</p><div class=\"checkin-options\"><button data-feeling=\"A little lighter\">☀ &nbsp; A little lighter</button><button data-feeling=\"Somewhere in between\">☁ &nbsp; Somewhere in between</button><button data-feeling=\"It’s a hard day\">🌧 &nbsp; It’s a hard day</button></div>`,actions:[['Close','']]},prompt:{icon:'✳',eyebrow:'A PLACE TO BEGIN',title:'Start wherever you are.',body:`<p style=\"background:#f2f4ee;padding:14px;border-radius:9px;color:#536556\"><strong>“What's something you've been carrying lately that you wish someone understood?”</strong></p><p>Use this prompt, or simply say what's on your mind in your own words.</p>`,actions:[['Another prompt','',()=>open('prompt')],['That helps','primary-action',close]]},safety:{icon:'♡',eyebrow:'YOUR SAFETY MATTERS',title:'A space built on care.',body:`<p>ALLone is for peer connection and mutual support. Listeners are community members, not licensed mental-health professionals. It is not a substitute for professional, medical, or crisis care.</p><p>Never share passwords, financial details, or your home address. You can leave or report a conversation that doesn't feel right.</p><p><strong>Need urgent help?</strong> If anyone is in immediate danger, contact local emergency services now.</p>`,actions:[['Got it','primary-action',close]]},community:{icon:'♡',eyebrow:'A LITTLE MORE HUMAN',title:'Kindness lives in small things.',body:`<p>Community stories and shared experiences will have a home here.</p><p>Real people. Meaningful conversations. No judgment.</p>`,actions:[['Back to home','primary-action',close]]},conversations:{icon:'◌',eyebrow:'YOUR CONVERSATIONS',title:'A quiet space, for now.',body:`<p>Conversations will appear here when live matching is available. This preview lets you explore the experience.</p>`,actions:[['Keep exploring','primary-action',close]]},about:{icon:'✳',eyebrow:'OUR PROMISE',title:'You are not alone. We are ALLone.',body:`<p>ALONE becomes ALL ONE with one extra L: we're all human, we all face difficult moments, and being heard can matter.</p><p>ALLone is peer support—not a dating app or social network.</p>`,actions:[['Close','primary-action',close]]}};\nfunction setRole(next){role=next;document.querySelectorAll('.role-option').forEach(b=>{const s=b.dataset.role===role;b.classList.toggle('selected',s);b.setAttribute('aria-pressed',String(s))});const people=document.getElementById('peopleList'),empty=document.getElementById('emptyState');if(role==='listener'){document.getElementById('listHeading').textContent='People who could use a listener';document.getElementById('listEyebrow').textContent='YOUR PRESENCE CAN MATTER';document.getElementById('welcomeSubheading').textContent='Thank you for being here for someone.';people.hidden=true;empty.hidden=false;empty.innerHTML='<span>♡</span><h3>There are no live requests in this preview</h3><p>In ALLone, people looking for support will appear here.</p>'}else{document.getElementById('listHeading').textContent='Listeners here for you';document.getElementById('listEyebrow').textContent='A GOOD PLACE TO START';document.getElementById('welcomeSubheading').textContent=\"Whatever brought you here, we're glad you did.\";people.hidden=false;empty.hidden=true;applyFilter()}}\nfunction applyFilter(){const cards=[...document.querySelectorAll('.person-card')];let count=0;cards.forEach(c=>{const show=filter==='all'||(filter==='available'&&c.dataset.available==='true')||(filter==='language'&&c.dataset.languages.includes('English'));c.hidden=!show;if(show)count++});document.getElementById('emptyState').hidden=count>0}\ndocument.querySelectorAll('.role-option').forEach(b=>b.onclick=()=>setRole(b.dataset.role));document.querySelectorAll('.filter-chip').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter-chip').forEach(c=>c.classList.toggle('active',c===b));applyFilter()});document.querySelectorAll('.connect-button').forEach(b=>b.onclick=()=>open('connect',b.dataset.person));document.getElementById('promptButton').onclick=()=>open('prompt');document.getElementById('checkInButton').onclick=()=>open('checkin');document.getElementById('dialogClose').onclick=close;dialog.onclick=e=>{if(e.target===dialog)close()};['safetyLink','safetyInline','footerSafety'].forEach(id=>document.getElementById(id).onclick=()=>open('safety'));document.getElementById('communityButton').onclick=()=>open('community');document.getElementById('footerAbout').onclick=()=>open('about');document.getElementById('findListenerButton').onclick=()=>role==='speaker'?document.querySelector('.discover-section').scrollIntoView({behavior:'smooth'}):toastShow('This is a preview — live connections aren’t available yet.');document.getElementById('seeAllButton').onclick=()=>toastShow('You’re seeing everyone in this preview.');document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-view]').forEach(i=>i.classList.toggle('active',i===b));if(b.dataset.view==='conversations')open('conversations');if(b.dataset.view==='community')open('community');if(b.dataset.view==='home')scrollTo({top:0,behavior:'smooth'})});document.getElementById('dialogBody').addEventListener('click',e=>{const o=e.target.closest('[data-feeling]');if(o){close();toastShow(`Thanks for checking in: ${o.dataset.feeling.toLowerCase()}.`)}});const h=new Date().getHours();document.getElementById('welcomeHeading').innerHTML=`Good ${h<12?'morning':h<18?'afternoon':'evening'}, Jamie <span class=\"wave\">✳</span>`;\n",
